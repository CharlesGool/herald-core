# herald-core 本身是 GSI 补丁 + 引擎源码,运行时无需环境变量。
# 下列仅在交叉编译引擎(keymint/inject,scripts/build-android.sh)时可选覆盖;只用 patch 的忽略本文件。
ANDROID_HOME=/opt/android/sdk                        # Android SDK 根目录(可选)
ANDROID_NDK_ROOT=/opt/android/sdk/ndk/29.0.14206865  # NDK 路径(可选,默认 $ANDROID_HOME/ndk/29.0.14206865)
BORINGSSL_DIR=~/.cargo/boringssl                     # BoringSSL checkout(可选,scripts/build-boringssl.sh 产出)
BORINGSSL_BUILD_DIR=~/.cargo/boringssl/build         # BoringSSL 构建目录(可选,默认 $BORINGSSL_DIR/build)
ANDROID_API_LEVEL=26                                 # 目标 Android API(可选)
HERALD_SOURCE_COMMIT=                                # 记进 BUILD-INFO 的源码 commit(可选,构建主机无 .git 时传入)
